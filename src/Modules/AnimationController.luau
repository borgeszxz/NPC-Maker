local AnimationController = {}

export type AnimationSet = {
	folder: string,
	value: string,
	assetId: number,
}

local FALLBACKS: { [string]: { AnimationSet } } = {
	R15 = {
		{ folder = "idle", value = "Animation1", assetId = 507766388 },
		{ folder = "idle", value = "Animation2", assetId = 507766666 },
		{ folder = "walk", value = "WalkAnim", assetId = 913402848 },
		{ folder = "run", value = "RunAnim", assetId = 913376220 },
		{ folder = "jump", value = "JumpAnim", assetId = 507765000 },
		{ folder = "fall", value = "FallAnim", assetId = 507767968 },
		{ folder = "climb", value = "ClimbAnim", assetId = 507765644 },
		{ folder = "sit", value = "SitAnim", assetId = 2506281703 },
	},
	R6 = {
		{ folder = "idle", value = "Animation1", assetId = 180435571 },
		{ folder = "idle", value = "Animation2", assetId = 180435792 },
		{ folder = "walk", value = "WalkAnim", assetId = 180426354 },
		{ folder = "run", value = "RunAnim", assetId = 180426354 },
		{ folder = "jump", value = "JumpAnim", assetId = 125750702 },
		{ folder = "fall", value = "FallAnim", assetId = 180436148 },
		{ folder = "climb", value = "ClimbAnim", assetId = 180436334 },
		{ folder = "sit", value = "SitAnim", assetId = 178130996 },
	},
}

AnimationController.SOURCE = [==[
-- Generated by NPC Maker. Standalone: this script has no dependency on the
-- plugin and can be copied into any place.
--
-- Server side replacement for the default Animate LocalScript, which does
-- not run for non-player characters. The Animation values below this script
-- are the ones Roblox generated for this avatar, so an equipped animation
-- package is preserved.

local npc = script.Parent
local humanoid = npc:WaitForChild("Humanoid")

local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
	animator = Instance.new("Animator")
	animator.Parent = humanoid
end

-- Walk clips are authored for the default 16 studs/s, so playback speed is
-- scaled against that. Above RUN_THRESHOLD the run clip takes over.
local REFERENCE_SPEED = 16
local RUN_THRESHOLD = 14
local MOVING_THRESHOLD = 0.5

local function findAnimationId(folderName, valueName)
	local folder = script:FindFirstChild(folderName)
	if not folder then
		return nil
	end

	local candidate = folder:FindFirstChild(valueName)
	if not (candidate and candidate:IsA("Animation")) then
		candidate = folder:FindFirstChildWhichIsA("Animation")
	end
	if candidate and candidate.AnimationId ~= "" then
		return candidate.AnimationId
	end
	return nil
end

local function loadTrack(folderName, valueName)
	local id = findAnimationId(folderName, valueName)
	if not id then
		return nil
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = id

	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	if not ok then
		return nil
	end
	return track
end

local tracks = {
	idle = loadTrack("idle", "Animation1"),
	walk = loadTrack("walk", "WalkAnim"),
	run = loadTrack("run", "RunAnim"),
	jump = loadTrack("jump", "JumpAnim"),
	fall = loadTrack("fall", "FallAnim"),
	climb = loadTrack("climb", "ClimbAnim"),
	sit = loadTrack("sit", "SitAnim"),
}

for _, name in ipairs({ "idle", "walk", "run", "climb", "sit" }) do
	local track = tracks[name]
	if track then
		track.Looped = true
	end
end

local current = nil

local function play(track, fade, speed)
	if track == current then
		if track and speed then
			track:AdjustSpeed(speed)
		end
		return
	end

	if current then
		current:Stop(fade)
	end

	current = track
	if track then
		track:Play(fade)
		track:AdjustSpeed(speed or 1)
	end
end

local function locomotion(speed)
	if speed < MOVING_THRESHOLD then
		play(tracks.idle, 0.2, 1)
		return
	end

	local track = tracks.walk
	if speed > RUN_THRESHOLD and tracks.run then
		track = tracks.run
	end

	play(track or tracks.idle, 0.15, math.clamp(speed / REFERENCE_SPEED, 0.4, 2))
end

humanoid.Running:Connect(locomotion)

humanoid.Jumping:Connect(function(active)
	if active then
		play(tracks.jump, 0.1, 1)
	end
end)

humanoid.FreeFalling:Connect(function(active)
	if active then
		play(tracks.fall, 0.2, 1)
	end
end)

humanoid.Climbing:Connect(function(speed)
	play(tracks.climb, 0.15, math.clamp(speed / REFERENCE_SPEED, 0.4, 2))
end)

humanoid.Seated:Connect(function(active)
	if active then
		play(tracks.sit, 0.2, 1)
	end
end)

humanoid.Died:Connect(function()
	play(nil, 0.2, 1)
end)

play(tracks.idle, 0, 1)
]==]

local function buildFallback(parent: Instance, rig: string)
	local sets = FALLBACKS[rig] or FALLBACKS.R15
	for _, entry in sets do
		local folder = parent:FindFirstChild(entry.folder)
		if folder == nil then
			folder = Instance.new("StringValue")
			folder.Name = entry.folder
			folder.Parent = parent
		end

		local animation = Instance.new("Animation")
		animation.Name = entry.value
		animation.AnimationId = string.format("rbxassetid://%d", entry.assetId)
		animation.Parent = folder
	end
end

function AnimationController.install(model: Model, rig: string): (boolean, string?)
	local original = model:FindFirstChild("Animate")

	local controller = Instance.new("Script")
	controller.Name = "Animate"
	controller.Source = AnimationController.SOURCE

	local note: string? = nil

	if original ~= nil then

		for _, child in original:GetChildren() do
			child.Parent = controller
		end
		original:Destroy()
	else
		buildFallback(controller, rig)
		note = "The rig had no Animate script; default " .. rig .. " animations were used."
	end

	controller.Parent = model
	return true, note
end

return AnimationController
