local BehaviorTemplates = {}

export type Template = {
	id: string,
	label: string,
	config: { [string]: number },
	source: string,
}

local PRELUDE = [==[
-- Generated by NPC Maker. This script is standalone: it does not require the
-- plugin and can be copied into any place as-is.

local Players = game:GetService("Players")

local npc = script.Parent
local humanoid = npc:WaitForChild("Humanoid")
local rootPart = npc:WaitForChild("HumanoidRootPart")
local config = npc:FindFirstChild("Config")

-- Config attributes win, then Model attributes, then the inline default.
local function setting(name, default)
	if config then
		local value = config:GetAttribute(name)
		if value ~= nil then
			return value
		end
	end
	local own = npc:GetAttribute(name)
	if own ~= nil then
		return own
	end
	return default
end

local function alive()
	return npc.Parent ~= nil and humanoid.Health > 0
end
]==]

local NEAREST_PLAYER = [==[
-- Nearest living player within range. Every field is checked: a character
-- can be missing, respawning, or partially loaded at any moment.
local function nearestPlayer(from, range)
	local closestRoot = nil
	local closestHumanoid = nil
	local closestDistance = nil

	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		if character then
			local otherHumanoid = character:FindFirstChildOfClass("Humanoid")
			local otherRoot = character:FindFirstChild("HumanoidRootPart")
			if otherHumanoid and otherRoot and otherHumanoid.Health > 0 then
				local distance = (otherRoot.Position - from).Magnitude
				if distance <= range and (closestDistance == nil or distance < closestDistance) then
					closestRoot = otherRoot
					closestHumanoid = otherHumanoid
					closestDistance = distance
				end
			end
		end
	end

	return closestRoot, closestHumanoid, closestDistance
end
]==]

local TEMPLATES: { Template } = {
	{
		id = "None",
		label = "None",
		config = {},
		source = "",
	},

	{
		id = "Idle",
		label = "Idle",
		config = {},
		source = PRELUDE .. [==[

-- Idle: the NPC holds its ground. It keeps facing the direction it was
-- created in and does not move on its own.
humanoid.AutoRotate = false

while alive() do
	humanoid:Move(Vector3.zero)
	task.wait(1)
end
]==],
	},

	{
		id = "Wander",
		label = "Wander",
		config = { WanderRadius = 25, WaitMin = 2, WaitMax = 5 },
		source = PRELUDE .. [==[

-- Wander: pick a random point inside WanderRadius of where the NPC spawned,
-- walk there, pause, repeat.
local home = rootPart.Position

while alive() do
	local radius = setting("WanderRadius", 25)
	local waitMin = setting("WaitMin", 2)
	local waitMax = setting("WaitMax", 5)
	if waitMax < waitMin then
		waitMax = waitMin
	end

	local angle = math.random() * math.pi * 2
	local distance = math.sqrt(math.random()) * radius
	local target = home + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)

	humanoid:MoveTo(target)
	-- MoveToFinished has its own 8 second timeout, so this cannot hang.
	humanoid.MoveToFinished:Wait()

	task.wait(waitMin + math.random() * (waitMax - waitMin))
end
]==],
	},

	{
		id = "Follow Player",
		label = "Follow Player",
		config = { DetectionRange = 50 },
		source = PRELUDE .. NEAREST_PLAYER .. [==[

-- Follow: walk toward the closest player inside DetectionRange.
local STEP = 0.25

while alive() do
	local range = setting("DetectionRange", 50)
	local targetRoot = nearestPlayer(rootPart.Position, range)

	if targetRoot then
		humanoid:MoveTo(targetRoot.Position)
	end

	task.wait(STEP)
end
]==],
	},

	{
		id = "Guard Area",
		label = "Guard Area",
		config = { DetectionRange = 50, GuardRadius = 30 },
		source = PRELUDE .. NEAREST_PLAYER .. [==[

-- Guard: stay near the spawn point. Chase an intruder only while it is
-- inside GuardRadius of home, otherwise walk back and hold position.
local STEP = 0.3
local home = rootPart.Position

while alive() do
	local detection = setting("DetectionRange", 50)
	local guardRadius = setting("GuardRadius", 30)

	local targetRoot = nearestPlayer(rootPart.Position, detection)
	local intruderInArea = false

	if targetRoot then
		intruderInArea = (targetRoot.Position - home).Magnitude <= guardRadius
	end

	if intruderInArea and targetRoot then
		humanoid:MoveTo(targetRoot.Position)
	elseif (rootPart.Position - home).Magnitude > 4 then
		humanoid:MoveTo(home)
	end

	task.wait(STEP)
end
]==],
	},

	{
		id = "Enemy",
		label = "Enemy",
		config = { DetectionRange = 50, AttackRange = 5, Damage = 10, AttackCooldown = 1 },
		source = PRELUDE .. NEAREST_PLAYER .. [==[

-- Enemy: find the nearest player, chase, and damage it when close enough.
-- Damage is applied on the server through Humanoid:TakeDamage.
local STEP = 0.2
local lastAttack = 0

while alive() do
	local detection = setting("DetectionRange", 50)
	local attackRange = setting("AttackRange", 5)
	local damage = setting("Damage", 10)
	local cooldown = setting("AttackCooldown", 1)

	local targetRoot, targetHumanoid, distance = nearestPlayer(rootPart.Position, detection)

	if targetRoot and targetHumanoid and distance then
		if distance > attackRange then
			humanoid:MoveTo(targetRoot.Position)
		else
			humanoid:MoveTo(rootPart.Position)
			local now = os.clock()
			if now - lastAttack >= cooldown then
				lastAttack = now
				targetHumanoid:TakeDamage(damage)
			end
		end
	end

	task.wait(STEP)
end
]==],
	},
}

function BehaviorTemplates.list(): { Template }
	return TEMPLATES
end

function BehaviorTemplates.get(id: string): Template
	for _, template in TEMPLATES do
		if template.id == id then
			return template
		end
	end
	return TEMPLATES[1]
end

function BehaviorTemplates.labels(): { string }
	local labels: { string } = {}
	for _, template in TEMPLATES do
		table.insert(labels, template.label)
	end
	return labels
end

return BehaviorTemplates
